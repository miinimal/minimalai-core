;; MINIMAL AI Escrow v1: non-custodial settlement between two agents for one task.
;;
;; No project key exists in this contract. Funds move only on a message from the poster or the worker:
;;   poster  RELS -> fee (fee_bps of the escrowed amount) to treasury, the rest to worker; contract self-destructs
;;   worker  DECL -> everything back to poster (worker declines); contract self-destructs
;;   poster  RFND -> everything back to poster, only after deadline; contract self-destructs
;;   poster  plain transfer (empty body / op 0) while open -> top-up
;; Anyone else, or any other op, is rejected (exit code > 0, message bounces back to the sender).
;;
;; Storage: poster:MsgAddress worker:MsgAddress ^[treasury:MsgAddress fee_bps:uint16 deadline:uint32 task_id:uint64]
;; The treasury receives only the fee (project revenue); it never holds the escrowed amount.

#include "stdlib.fc";

int equal_slices(slice a, slice b) asm "SDEQ";

const op::release = 0x52454c53;  ;; "RELS"
const op::decline = 0x4445434c;  ;; "DECL"
const op::refund = 0x52464e44;   ;; "RFND"

const err::not_poster = 401;
const err::not_worker = 402;
const err::too_early = 403;
const err::bad_op = 404;
const err::bad_fee = 405;

const MAX_FEE_BPS = 2000;        ;; hard cap 20% in code; the actual rate is set per escrow
const RESERVE = 10000000;        ;; 0.01 TON kept for fees of the outgoing messages

(slice, slice, slice, int, int, int) load_data() inline {
    slice ds = get_data().begin_parse();
    slice poster = ds~load_msg_addr();
    slice worker = ds~load_msg_addr();
    slice p = ds~load_ref().begin_parse();
    return (poster, worker, p~load_msg_addr(), p~load_uint(16), p~load_uint(32), p~load_uint(64));
}

() send_all(slice to, int amount, int mode) impure inline {
    send_raw_message(begin_cell().store_uint(0x10, 6).store_slice(to).store_coins(amount)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1).end_cell(), mode);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full.begin_parse();
    if (cs~load_uint(4) & 1) { return (); }  ;; ignore bounces
    slice sender = cs~load_msg_addr();
    (slice poster, slice worker, slice treasury, int fee_bps, int deadline, int task_id) = load_data();
    throw_unless(err::bad_fee, fee_bps <= MAX_FEE_BPS);

    int op = in_msg_body.slice_bits() >= 32 ? in_msg_body~load_uint(32) : 0;
    if (op == 0) {  ;; deploy / top-up: only the poster funds the escrow
        throw_unless(err::not_poster, equal_slices(sender, poster));
        return ();
    }
    if (op == op::release) {
        throw_unless(err::not_poster, equal_slices(sender, poster));
        int amount = my_balance - msg_value - RESERVE;  ;; escrowed amount, without this message's gas
        int fee = amount > 0 ? amount * fee_bps / 10000 : 0;
        if (fee > 0) { send_all(treasury, fee, 1); }
        send_all(worker, 0, 128 + 32);
        return ();
    }
    if (op == op::decline) {
        throw_unless(err::not_worker, equal_slices(sender, worker));
        send_all(poster, 0, 128 + 32);
        return ();
    }
    if (op == op::refund) {
        throw_unless(err::not_poster, equal_slices(sender, poster));
        throw_unless(err::too_early, now() > deadline);
        send_all(poster, 0, 128 + 32);
        return ();
    }
    throw(err::bad_op);
}

(slice, slice, slice, int, int, int) get_escrow() method_id {
    return load_data();
}

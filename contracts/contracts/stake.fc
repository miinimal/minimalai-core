;; MINIMAL AI Stake v1 (block B17): a reputation stake that stays in the agent's own contract.
;;
;; The owner (agent wallet) deposits; the slasher (the project's anchor wallet) can only move funds to the fixed
;; treasury address - never to itself, never anywhere else - and only up to the balance. The owner withdraws the whole
;; balance after requesting unlock and waiting unlock_s (so a pending review/jury cannot be dodged by a quick exit).
;; Nothing here is custody: the project cannot take the stake for itself.
;;
;; Storage: owner:MsgAddress slasher:MsgAddress treasury:MsgAddress unlock_s:uint32 unlock_at:uint32 (0 = locked)
;;          purpose:uint64 (what the stake backs: 1 review, 2 grant jury, 3 arbitration jury; informational)
;; Messages:
;;   plain transfer (op 0)               anyone tops up (normally the owner)
;;   op::unlock (0x554e4c4b "UNLK")      owner: start the unlock clock (unlock_at = now + unlock_s)
;;   op::relock (0x52454c4b "RELK")      owner: cancel the unlock (stake active again)
;;   op::withdraw (0x57495448 "WITH")    owner, after unlock_at: everything to the owner, contract destroyed
;;   op::slash (0x534c5348 "SLSH") amount:Coins ^reason  slasher: amount (<= balance - reserve) to the treasury
;; Get-method get_stake() -> (owner, slasher, treasury, unlock_s, unlock_at, purpose, balance)

#include "stdlib.fc";

int equal_slices(slice a, slice b) asm "SDEQ";

const op::unlock = 0x554e4c4b;
const op::relock = 0x52454c4b;
const op::withdraw = 0x57495448;
const op::slash = 0x534c5348;

const err::not_owner = 401;
const err::not_slasher = 402;
const err::locked = 403;
const err::bad_op = 404;
const err::too_much = 405;

const RESERVE = 10000000;   ;; 0.01 TON stays for message fees

(slice, slice, slice, int, int, int) load_data() inline {
    slice ds = get_data().begin_parse();
    return (ds~load_msg_addr(), ds~load_msg_addr(), ds~load_msg_addr(), ds~load_uint(32), ds~load_uint(32), ds~load_uint(64));
}

() save_data(slice owner, slice slasher, slice treasury, int unlock_s, int unlock_at, int purpose) impure inline {
    set_data(begin_cell().store_slice(owner).store_slice(slasher).store_slice(treasury).store_uint(unlock_s, 32)
        .store_uint(unlock_at, 32).store_uint(purpose, 64).end_cell());
}

() send(slice to, int amount, int mode, cell body) impure inline {
    builder b = begin_cell().store_uint(0x10, 6).store_slice(to).store_coins(amount).store_uint(0, 1 + 4 + 4 + 64 + 32 + 1);
    if (null?(body)) { b = b.store_uint(0, 1); } else { b = b.store_uint(1, 1).store_ref(body); }
    send_raw_message(b.end_cell(), mode);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full.begin_parse();
    if (cs~load_uint(4) & 1) { return (); }
    slice sender = cs~load_msg_addr();
    int op = in_msg_body.slice_bits() >= 32 ? in_msg_body~load_uint(32) : 0;
    if (op == 0) { return (); }   ;; top-up
    (slice owner, slice slasher, slice treasury, int unlock_s, int unlock_at, int purpose) = load_data();
    in_msg_body~load_uint(64);    ;; query_id
    if (op == op::unlock) {
        throw_unless(err::not_owner, equal_slices(sender, owner));
        save_data(owner, slasher, treasury, unlock_s, now() + unlock_s, purpose);
        return ();
    }
    if (op == op::relock) {
        throw_unless(err::not_owner, equal_slices(sender, owner));
        save_data(owner, slasher, treasury, unlock_s, 0, purpose);
        return ();
    }
    if (op == op::withdraw) {
        throw_unless(err::not_owner, equal_slices(sender, owner));
        throw_unless(err::locked, (unlock_at != 0) & (now() >= unlock_at));
        send(owner, 0, 128 + 32, null());
        return ();
    }
    if (op == op::slash) {
        throw_unless(err::not_slasher, equal_slices(sender, slasher));
        int amount = in_msg_body~load_coins();
        cell reason = in_msg_body~load_ref();
        throw_unless(err::too_much, amount <= my_balance - msg_value - RESERVE);
        send(treasury, amount, 1, reason);   ;; only ever to the treasury fixed at deployment
        return ();
    }
    throw(err::bad_op);
}

(slice, slice, slice, int, int, int, int) get_stake() method_id {
    (slice owner, slice slasher, slice treasury, int unlock_s, int unlock_at, int purpose) = load_data();
    return (owner, slasher, treasury, unlock_s, unlock_at, purpose, get_balance().pair_first());
}

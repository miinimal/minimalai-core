;; MINIMALCULT city number — NFT item (TEP-62) that is also a DNS resolver (TEP-81), block B10c.
;;
;; One item per number N: "N.minimalcult.ton" resolves to the item's owner (record dns_smc_address of the owner's wallet),
;; so whoever holds the NFT holds the address; a transfer moves the address with it. The project mints through the
;; collection and may hold an item for an agent that has no wallet yet; it never touches an item it has transferred.
;;
;; Storage: index:uint64 collection:MsgAddressInt [owner:MsgAddressInt content:^Cell] (owner part absent until deployed)
;; Messages: op::transfer (0x5fcc3d14) per TEP-62 (owner only) with forward_payload / forward_amount / response;
;;           op::get_static_data (0x2fcb26a2) -> report_static_data (0x8b771735).
;; Get-methods: get_nft_data, dnsresolve (TEP-81; "\0" or empty -> own record set), get_owner.

#include "stdlib.fc";

int equal_slices(slice a, slice b) asm "SDEQ";
int string_hash(slice s) asm "SHA256U";

const op::transfer = 0x5fcc3d14;
const op::ownership_assigned = 0x05138d91;
const op::excesses = 0xd53276db;
const op::get_static_data = 0x2fcb26a2;
const op::report_static_data = 0x8b771735;

const err::not_owner = 401;
const err::not_collection = 405;
const err::bad_op = 404;
const err::low_value = 402;

const DNS_SMC_ADDRESS = 0x9fd3;
const min_tons_for_storage = 50000000;   ;; 0.05 TON stays on the item

(int, int, slice, slice, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    int index = ds~load_uint(64);
    slice collection = ds~load_msg_addr();
    if (ds.slice_bits() > 0) {
        return (-1, index, collection, ds~load_msg_addr(), ds~load_ref());
    }
    return (0, index, collection, null(), null());
}

() store_data(int index, slice collection, slice owner, cell content) impure inline {
    set_data(begin_cell().store_uint(index, 64).store_slice(collection).store_slice(owner).store_ref(content).end_cell());
}

slice null_addr() asm "b{00} PUSHSLICE";

() force_chain(slice addr) impure inline {
    (int wc, _) = parse_std_addr(addr);
    throw_unless(333, wc == 0);
}

int is_null_addr(slice s) inline {
    return s.preload_uint(2) == 0;
}

() send_msg(slice to, int amount, int op, int query_id, builder payload, int mode) impure inline {
    builder msg = begin_cell().store_uint(0x10, 6).store_slice(to).store_coins(amount)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1).store_uint(op, 32).store_uint(query_id, 64);
    if (~ null?(payload)) { msg = msg.store_builder(payload); }
    send_raw_message(msg.end_cell(), mode);
}

() transfer(int my_balance, int index, slice collection, slice owner, cell content, slice sender, int query_id, slice body, int fwd_fee) impure inline {
    throw_unless(err::not_owner, equal_slices(sender, owner));
    slice new_owner = body~load_msg_addr();
    force_chain(new_owner);
    slice response = body~load_msg_addr();
    body~load_int(1);                       ;; custom_payload (none)
    int forward_amount = body~load_coins();
    int rest = my_balance - min_tons_for_storage;
    throw_unless(err::low_value, rest > forward_amount + fwd_fee * (is_null_addr(response) ? 1 : 2));
    if (forward_amount > 0) {
        send_msg(new_owner, forward_amount, op::ownership_assigned, query_id,
                 begin_cell().store_slice(owner).store_slice(body), 1);
        rest -= forward_amount + fwd_fee;
    }
    if (~ is_null_addr(response)) {
        send_msg(response, rest, op::excesses, query_id, null(), 1);
    }
    store_data(index, collection, new_owner, content);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }
    slice sender = cs~load_msg_addr();
    cs~load_msg_addr(); cs~load_coins(); cs~skip_bits(1); cs~load_coins();
    int fwd_fee = muldiv(cs~load_coins(), 3, 2);
    (int init?, int index, slice collection, slice owner, cell content) = load_data();
    if (~ init?) {
        throw_unless(err::not_collection, equal_slices(collection, sender));
        store_data(index, collection, in_msg_body~load_msg_addr(), in_msg_body~load_ref());
        return ();
    }
    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);
    if (op == op::transfer) {
        transfer(my_balance, index, collection, owner, content, sender, query_id, in_msg_body, fwd_fee);
        return ();
    }
    if (op == op::get_static_data) {
        send_msg(sender, 0, op::report_static_data, query_id, begin_cell().store_uint(index, 256).store_slice(collection), 64);
        return ();
    }
    throw(err::bad_op);
}

(int, int, slice, slice, cell) get_nft_data() method_id {
    return load_data();
}

slice get_owner() method_id {
    (_, _, _, slice owner, _) = load_data();
    return owner;
}

;; TEP-81: the item answers only for itself: "\0" (initial form) or empty (recursive form) -> its record set.
(int, cell) dnsresolve(slice subdomain, int category) method_id {
    int bits = subdomain.slice_bits();
    if (bits > 8) { return (0, null()); }
    if ((bits == 8) & (subdomain.preload_uint(8) != 0)) { return (0, null()); }
    (int init?, _, _, slice owner, _) = load_data();
    if (~ init?) { return (bits, null()); }
    cell smc = begin_cell().store_uint(DNS_SMC_ADDRESS, 16).store_slice(owner).store_uint(0, 8).end_cell();
    int consumed = bits;
    if (consumed == 0) { consumed = 8; }   ;; nothing left to consume: report the terminator as resolved
    if (category == 0) {
        cell set = new_dict();
        set~udict_set_ref(256, string_hash("wallet"), smc);
        return (consumed, set);
    }
    if (category == string_hash("wallet")) { return (consumed, smc); }
    return (consumed, null());
}
